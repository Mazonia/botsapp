# ===================================================================
# BotsApp Configuration
# Enterprise WhatsApp Gateway & API Platform
# ===================================================================

# Port & Server Host
PORT=3001
HOST=0.0.0.0

# Optional API Security Key (Leave empty to disable authentication)
# If set, all requests to /api/* must pass header `X-Api-Key: your_key` or `Authorization: Bearer your_key`
API_KEY=

# Default Webhook Destinations (comma-separated URLs)
# BotsApp will deliver all inbound messages, delivery receipts (ACK), and session events here
WEBHOOK_URLS=http://127.0.0.1:8000/webhooks/whatsapp,http://localhost:8000/webhooks/whatsapp

# Secret for signing Webhook payloads using HMAC SHA-256 (optional)
WEBHOOK_SECRET=

# Anti-Ban Safeguards
# Maximum messages allowed per day (auto-resets at midnight)
WA_DAILY_LIMIT=120

# Force delay multiplier (1.0 = standard human speed, 1.5 = slower/safer)
ANTI_BAN_SPEED_MULTIPLIER=1.0

# Session Warmup Protection (true/false)
WARMUP_PROTECTION=true

# Puppeteer / Headless Browser Options
HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=

# Auto-Responder / Bot Engine
AUTO_RESPONDER_ENABLED=true
